#!/bin/sh
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$project_root/.tools/node/bin/node" ]; then
  exec "$project_root/.tools/node/bin/node" "$project_root/scripts/project.mjs" "$@"
fi
if command -v node >/dev/null 2>&1; then
  exec node "$project_root/scripts/project.mjs" "$@"
fi
printf '%s\n' 'Run: sh scripts/setup.sh' >&2
exit 1
